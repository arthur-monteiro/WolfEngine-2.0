R"(
#extension GL_EXT_nonuniform_qualifier : enable

struct CullingInstanceInfo
{
	mat4 transform;
	uint meshIdx;
	uint materialIdx;
	uint customData;
	uint batchesMask;
};
layout(std430, binding = 0) restrict buffer CullingInstancesBufferLayout
{
    CullingInstanceInfo cullingInstancesInfo[];
};

struct LODInfo
{
	uint vertexOffset;
	uint indexOffset;
	uint indexCount;
	uint clusterOffset;

    uint clusterCount;
	float maxDistance;
};
const uint MAX_LOD_COUNT = 20;

struct MeshInfo
{
	LODInfo lods[MAX_LOD_COUNT];
	vec4 boundingSphere;

	vec4 aabbMin;
	vec4 aabbMax;
};
layout(std430, binding = 1) restrict buffer MeshesInfoBufferLayout
{
    MeshInfo meshesInfo[];
};

const uint MAX_BATCH_COUNT = 32;

struct OutInstanceData
{
	mat4 transform;
	uint materialIdx;
	uint customData;
	uint lod;
};
layout(std430, binding = 2) restrict buffer OutInstancesBufferLayout
{
    OutInstanceData outInstancesData[];
} outInstancesDataBuffers[MAX_BATCH_COUNT];

layout(std430, binding = 3) restrict buffer CountBufferLayout
{
    uint drawCount[MAX_BATCH_COUNT];
};

// TODO: this correspond to VkDrawIndexedIndirectCommand and should be handled in a multi-API way
struct DrawCommand
{
	uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};
layout(std430, binding = 4) restrict buffer OutDrawCommandsLayout
{
   	DrawCommand outDrawCommands[];
} outDrawCommandsBuffers[MAX_BATCH_COUNT];

layout(binding = 5, std140) uniform readonly UniformBufferLayout
{
	uint instanceCount;
	uint frameIdx;
} ub;

layout(binding = 6) uniform sampler2D HZBSampler;

#ifdef MESH_STREAMING
const uint MAX_FEEDBACK_COUNT = 32;
struct Feedback
{
    uint meshIdx;
    uint lod;
};
layout(std430, binding = 7) restrict buffer OutStreamingFeedbacksLayout
{
   	uint outFeedbackCount;
   	Feedback outFeedbacks[MAX_FEEDBACK_COUNT];
} outStreamingFeedbacksBuffer;

struct LatestFrameIdxPerLOD
{
    uint frameIdx[MAX_LOD_COUNT];
};
layout(std430, binding = 8) restrict buffer OutStreamingLatestFrameIdxLayout
{
   	LatestFrameIdxPerLOD latestFrameIdxPerLODs[];
} outStreamingLatestFrameIdx;
#endif

layout(std430, binding =
#ifdef MESH_STREAMING
    9
#else
    7
#endif
) restrict buffer OutDebugData
{
   	uint instanceCount;
   	uint primitiveCount;
} outDebugData;

layout(push_constant) uniform PushConstants
{
	uint cameraBatchMask;
} pc;

bool isSphereVisible(in vec4 sphere, in vec4 planes[6])
{
    for (int i = 0; i < 6; i++)
    {
        float distance = dot(planes[i].xyz, sphere.xyz) + planes[i].w;
        if (distance < -sphere.w)
        {
            return false;
        }
    }
    return true;
}

float compteSphereDistance(vec3 p, vec4 sphere)
{
    float d = distance(p, sphere.xyz);
    return d - sphere.w;
}

bool isSphereVisibleHZB(in vec3 aabbMin, in vec3 aabbMax, in mat4 viewProjMatrix)
{
	vec4 corners[8];
	corners[0] = viewProjMatrix * vec4(aabbMin.x, aabbMin.y, aabbMin.z, 1.0);
	corners[1] = viewProjMatrix * vec4(aabbMax.x, aabbMin.y, aabbMin.z, 1.0);
	corners[2] = viewProjMatrix * vec4(aabbMin.x, aabbMax.y, aabbMin.z, 1.0);
	corners[3] = viewProjMatrix * vec4(aabbMax.x, aabbMax.y, aabbMin.z, 1.0);
	corners[4] = viewProjMatrix * vec4(aabbMin.x, aabbMin.y, aabbMax.z, 1.0);
	corners[5] = viewProjMatrix * vec4(aabbMax.x, aabbMin.y, aabbMax.z, 1.0);
	corners[6] = viewProjMatrix * vec4(aabbMin.x, aabbMax.y, aabbMax.z, 1.0);
	corners[7] = viewProjMatrix * vec4(aabbMax.x, aabbMax.y, aabbMax.z, 1.0);

	vec3 minNDC = vec3(1e5);
	vec3 maxNDC = vec3(-1e5);

	for (int i = 0; i < 8; ++i)
	{
		// Objects crossing or behind near plane
		if (corners[i].w <= 0.001)
			return true;

		vec3 ndc = corners[i].xyz / corners[i].w;
		minNDC = min(minNDC, ndc);
		maxNDC = max(maxNDC, ndc);
	}

	vec4 vp = getViewport();
	vec2 fullDepthSize = vec2(textureSize(HZBSampler, 0)) * 2.0; // first mip of HZB is second mip of depth

	vec2 localUVMin = clamp(minNDC.xy * 0.5 + 0.5, 0.0, 1.0);
	vec2 localUVMax = clamp(maxNDC.xy * 0.5 + 0.5, 0.0, 1.0);

	vec2 globalUVMin = (vp.xy + localUVMin * vp.zw) / fullDepthSize;
	vec2 globalUVMax = (vp.xy + localUVMax * vp.zw) / fullDepthSize;

	float nearestDepth = maxNDC.z + 0.0001;

	vec2 hzbBaseSize = vec2(textureSize(HZBSampler, 0));
	vec2 sizeInHZBTexels = (globalUVMax - globalUVMin) * hzbBaseSize;

	float maxDimension = max(max(sizeInHZBTexels.x, sizeInHZBTexels.y), 0.0001);
	float mip = max(0.0, ceil(log2(maxDimension))) - 1;
	float maxMipIndex = floor(log2(max(hzbBaseSize.x, hzbBaseSize.y))) - 2; // -2 to follow MipMapGenerator::computeMipCount
	mip = min(mip, maxMipIndex);

	vec2 mipSize = vec2(textureSize(HZBSampler, int(mip)));
	vec2 texelMin = floor(globalUVMin * mipSize);
	vec2 texelMax = floor(globalUVMax * mipSize);

	vec2 sampleUV1 = (texelMin + vec2(0.5, 0.5)) / mipSize;
	vec2 sampleUV2 = (vec2(texelMax.x, texelMin.y) + vec2(0.5, 0.5)) / mipSize;
	vec2 sampleUV3 = (vec2(texelMin.x, texelMax.y) + vec2(0.5, 0.5)) / mipSize;
	vec2 sampleUV4 = (texelMax + vec2(0.5, 0.5)) / mipSize;

	float d1 = textureLod(HZBSampler, sampleUV1, mip).r;
	float d2 = textureLod(HZBSampler, sampleUV2, mip).r;
	float d3 = textureLod(HZBSampler, sampleUV3, mip).r;
	float d4 = textureLod(HZBSampler, sampleUV4, mip).r;

	float hzbDepth = min(min(d1, d2), min(d3, d4));

	return nearestDepth >= hzbDepth;
}

void transformWorldAABB(in vec3 localMin, in vec3 localMax, in mat4 worldMatrix, out vec3 worldMin, out vec3 worldMax)
{
	vec3 center = (localMin + localMax) * 0.5;
	vec3 extent = (localMax - localMin) * 0.5;

	vec3 worldCenter = (worldMatrix * vec4(center, 1.0)).xyz;

	mat3 absWorld = mat3(
		abs(worldMatrix[0].xyz),
		abs(worldMatrix[1].xyz),
		abs(worldMatrix[2].xyz)
	);

	vec3 worldExtent = absWorld * extent;

	worldMin = worldCenter - worldExtent;
	worldMax = worldCenter + worldExtent;
}

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main()
{
	uint instanceIdx = gl_GlobalInvocationID.x;
	if (instanceIdx >= ub.instanceCount)
		return;
	
	CullingInstanceInfo cullingInstanceInfo = cullingInstancesInfo[instanceIdx];
	MeshInfo meshInfo = meshesInfo[cullingInstanceInfo.meshIdx];

	if (cullingInstanceInfo.transform[0][0] == 0.0) // is means that the instance has been deactivated
	{
		return;
	}

	vec4 boundingSphereCenter = cullingInstanceInfo.transform * vec4(meshInfo.boundingSphere.xyz, 1.0);
    float boundingSphereRadius = meshInfo.boundingSphere.w;
    float sx = dot(cullingInstanceInfo.transform[0].xyz, cullingInstanceInfo.transform[0].xyz);
	float sy = dot(cullingInstanceInfo.transform[1].xyz, cullingInstanceInfo.transform[1].xyz);
	float sz = dot(cullingInstanceInfo.transform[2].xyz, cullingInstanceInfo.transform[2].xyz);
	float maxScale = sqrt(max(sx, max(sy, sz)));
    boundingSphereRadius *= maxScale;
    vec4 boundingSphere = vec4(vec3(boundingSphereCenter), boundingSphereRadius);

	if (!isSphereVisible(boundingSphere, ubCamera.frustumPlanes))
		return;

	vec3 aabbMin;
	vec3 aabbMax;
	transformWorldAABB(meshInfo.aabbMin.xyz, meshInfo.aabbMax.xyz, cullingInstanceInfo.transform, aabbMin, aabbMax);
	mat4 viewProj = getProjectionMatrix() * getViewMatrix();
	if (!isSphereVisibleHZB(aabbMin, aabbMax, viewProj))
		return;

	float distanceWithCamera = compteSphereDistance(getCameraPos(), boundingSphere);
	uint lod = 0;
	for (; lod < MAX_LOD_COUNT; lod++)
	{
		if (meshInfo.lods[0].maxDistance < 0.0)
		{
			lod = MAX_LOD_COUNT;
		}
		else if (distanceWithCamera < (meshInfo.lods[lod].maxDistance * maxScale))
		{
			break;
		}
	}

	if (lod >= MAX_LOD_COUNT)
		return;

#ifdef MESH_STREAMING
    uint requestedLOD = lod;

    bool hasFoundValidData = false;
    bool needToAddFeedback = false;
    while (lod < MAX_LOD_COUNT)
    {
        if (meshInfo.lods[lod].vertexOffset != -1)
            hasFoundValidData = true;

        if (!hasFoundValidData)
        {
            needToAddFeedback = true;
            lod++;
        }
        else
        {
            break;
        }
    }

    if (needToAddFeedback)
    {
        uint feedbackCount = atomicAdd(outStreamingFeedbacksBuffer.outFeedbackCount, 1);
        if (feedbackCount < MAX_FEEDBACK_COUNT)
        {
            outStreamingFeedbacksBuffer.outFeedbacks[feedbackCount].meshIdx = cullingInstanceInfo.meshIdx;
            outStreamingFeedbacksBuffer.outFeedbacks[feedbackCount].lod = requestedLOD;
        }
    }

    outStreamingLatestFrameIdx.latestFrameIdxPerLODs[cullingInstanceInfo.meshIdx].frameIdx[requestedLOD] = ub.frameIdx;

    if (!hasFoundValidData)
    {
        return;
    }

#endif

	for (uint batchIdx = 0; batchIdx < MAX_BATCH_COUNT; batchIdx++)
	{
		if ((cullingInstanceInfo.batchesMask & (1u << batchIdx)) != 0u &&
			(pc.cameraBatchMask & (1u << batchIdx)) != 0)
		{
			uint outCommandIdx = atomicAdd(drawCount[batchIdx], 1);
			outInstancesDataBuffers[batchIdx].outInstancesData[outCommandIdx].transform = cullingInstanceInfo.transform;
			outInstancesDataBuffers[batchIdx].outInstancesData[outCommandIdx].materialIdx = cullingInstanceInfo.materialIdx;
			outInstancesDataBuffers[batchIdx].outInstancesData[outCommandIdx].customData = cullingInstanceInfo.customData;
			outInstancesDataBuffers[batchIdx].outInstancesData[outCommandIdx].lod = lod;

			outDrawCommandsBuffers[batchIdx].outDrawCommands[outCommandIdx].vertexOffset = int(meshInfo.lods[lod].vertexOffset);
			outDrawCommandsBuffers[batchIdx].outDrawCommands[outCommandIdx].firstIndex = meshInfo.lods[lod].indexOffset;
			outDrawCommandsBuffers[batchIdx].outDrawCommands[outCommandIdx].indexCount = meshInfo.lods[lod].indexCount;
			outDrawCommandsBuffers[batchIdx].outDrawCommands[outCommandIdx].instanceCount = 1;
			outDrawCommandsBuffers[batchIdx].outDrawCommands[outCommandIdx].firstInstance = 0;

            atomicAdd(outDebugData.instanceCount, 1);
            atomicAdd(outDebugData.primitiveCount, meshInfo.lods[lod].indexCount);
		}
	}
}
)"