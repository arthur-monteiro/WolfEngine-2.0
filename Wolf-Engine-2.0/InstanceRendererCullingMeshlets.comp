R"(
#extension GL_EXT_nonuniform_qualifier : enable

struct CullingInstanceInfo
{
	mat4 transform;
	uint meshIdx;
	uint materialIdx;
	uint customData;
	uint batchesMask;
};
layout(std430, binding = 0) restrict buffer CullingInstancesBufferLayout
{
    CullingInstanceInfo cullingInstancesInfo[];
};

const uint MAX_BATCH_COUNT = 32;

struct OutMeshletData
{
	uint instanceIdx;
	uint vertexCount;
	uint vertexOffset;
    uint indexOffset;

    uint indexCount;
    uint meshletIdx;
    uint groupMeshletIdx;
    uint pad2;
};
layout(std430, binding = 1) restrict buffer OutInstancesBufferLayout
{
    OutMeshletData outMeshletData[];
} outMeshletDataBuffers[MAX_BATCH_COUNT];

struct MeshletInstanceData
{
    uint instanceIdx;
    uint meshletIdx;
    uint meshIdx;
    uint pad1;
};
layout(std430, binding = 2) restrict buffer MeshletInstancesBufferLayout
{
    MeshletInstanceData meshletInstancesData[];
} meshletInstancesDataBuffer;

struct MeshInfo
{
    uint meshletBaseIndex;
    uint meshletCount;
    uint pad0;
    uint pad1;

    vec4 boundingSphere;
    vec4 aabbMin;
    vec4 aabbMax;
};
layout(std430, binding = 3) restrict buffer MeshesInfoBufferLayout
{
    MeshInfo meshesInfo[];
};

// TODO: this correspond to VkDrawIndexedIndirectCommand and should be handled in a multi-API way
struct DrawMeshTaskCommand
{
	uint groupCountX;
	uint groupCountY;
	uint groupCountZ;
};
layout(std430, binding = 4) restrict buffer OutDrawCommandLayout
{
   	DrawMeshTaskCommand outDrawCommand;
} outDrawCommandsBuffers[MAX_BATCH_COUNT];

layout(binding = 5) uniform sampler2D HZBSampler;

struct MeshletInfo
{
    uint vertexOffset;
    uint indexOffset;
    uint indexCount;
    float lodError;

    float parentLodError;
    uint coneAxisAndCutoff;
    uint vertexCount;
    uint groupIdxAsParent;

    vec4 boundingSphere;
    vec4 parentGroupBoundingSphere;

    uint groupIdxAsChild;
};
layout(std430, binding = 6) restrict buffer MeshletsInfoBufferLayout
{
    MeshletInfo meshletsInfo[];
};

layout(std430, binding = 7) restrict buffer OutDebugData
{
   	uint instanceCount;
   	uint primitiveCount;
   	uint meshletPassingCullingCount;
} outDebugData;

layout(std430, binding = 8) restrict buffer MeshletCountBufferLayout
{
    uint meshletCount;
};

struct MeshletGroupInfo
{
    vec4 boundingSphere;
    uint childrenMeshletIndices[4];
    uint parentMeshletIndices[4];
    uint hierarchyLevel;
};
layout(std430, binding = 9) restrict buffer MeshletGroupsInfoBufferLayout
{
    MeshletGroupInfo meshletGroupsInfo[];
};

#ifdef MESH_STREAMING
const uint MAX_FEEDBACK_COUNT = 32;
struct Feedback
{
    uint meshIdx;
    uint meshletIdx;
};
layout(std430, binding = 10) restrict buffer OutStreamingFeedbacksLayout
{
   	uint outFeedbackCount;
   	Feedback outFeedbacks[MAX_FEEDBACK_COUNT];
} outStreamingFeedbacksBuffer;

const uint LOADED_MESH_USAGE_BITMASK_COUNT = 1024; // 1024 * 32 = 32768 max meshlets loaded
layout(std430, binding = 11) restrict buffer OutUsedLoadedMeshletsLayout
{
   	uint isMeshletUsedBitMasks[LOADED_MESH_USAGE_BITMASK_COUNT];
} outUsedLoadedMeshletsBuffer;
#endif

layout(push_constant) uniform PushConstants
{
	uint cameraBatchMask;
	uint debugDrawMeshletHierarchyLevel;
	uint debugMeshletDrawGroupIdx;
	uint debugUseParentGroup;
	uint onlyDrawMeshletIdx;
} pc;

bool isSphereVisible(in vec4 sphere, in vec4 planes[6])
{
    for (int i = 0; i < 6; i++)
    {
        float distance = dot(planes[i].xyz, sphere.xyz) + planes[i].w;
        if (distance < -sphere.w)
        {
            return false;
        }
    }
    return true;
}

float compteSphereDistance(vec3 p, vec4 sphere)
{
    float d = distance(p, sphere.xyz);
    return d - sphere.w;
}

bool isSphereVisibleHZB(in vec4 sphere, in mat4 viewMatrix, in mat4 projMatrix)
{
    vec4 viewCenter = viewMatrix * vec4(sphere.xyz, 1.0);
    float radius = sphere.w;

    if (viewCenter.z + radius >= -0.001)
        return true;

    vec4 clipCenter = projMatrix * viewCenter;
    vec3 centerNDC = clipCenter.xyz / clipCenter.w;

    float absZ = abs(viewCenter.z);
    vec2 radiusNDC = vec2(projMatrix[0][0], projMatrix[1][1]) * radius / absZ;

    vec2 minNDC = centerNDC.xy - radiusNDC;
    vec2 maxNDC = centerNDC.xy + radiusNDC;

    vec4 viewNearest = vec4(viewCenter.xy, viewCenter.z + radius, 1.0);
    vec4 clipNearest = projMatrix * viewNearest;
    float nearestDepth = clipNearest.z / clipNearest.w;

    nearestDepth += 0.0001;

    vec4 vp = getViewport();
    vec2 fullDepthSize = vec2(textureSize(HZBSampler, 0)) * 2.0;

    vec2 localUVMin = clamp(minNDC * 0.5 + 0.5, 0.0, 1.0);
    vec2 localUVMax = clamp(maxNDC * 0.5 + 0.5, 0.0, 1.0);

    vec2 globalUVMin = (vp.xy + localUVMin * vp.zw) / fullDepthSize;
    vec2 globalUVMax = (vp.xy + localUVMax * vp.zw) / fullDepthSize;

    vec2 hzbBaseSize = vec2(textureSize(HZBSampler, 0));
    vec2 sizeInHZBTexels = (globalUVMax - globalUVMin) * hzbBaseSize;

    float maxDimension = max(max(sizeInHZBTexels.x, sizeInHZBTexels.y), 0.0001);
    float mip = max(0.0, ceil(log2(maxDimension))) - 1.0;
    float maxMipIndex = floor(log2(max(hzbBaseSize.x, hzbBaseSize.y))) - 2.0;
    mip = min(mip, maxMipIndex);

    vec2 mipSize = vec2(textureSize(HZBSampler, int(mip)));
    vec2 texelMin = floor(globalUVMin * mipSize);
    vec2 texelMax = floor(globalUVMax * mipSize);

    vec2 sampleUV1 = (texelMin + vec2(0.5)) / mipSize;
    vec2 sampleUV2 = (vec2(texelMax.x, texelMin.y) + vec2(0.5)) / mipSize;
    vec2 sampleUV3 = (vec2(texelMin.x, texelMax.y) + vec2(0.5)) / mipSize;
    vec2 sampleUV4 = (texelMax + vec2(0.5)) / mipSize;

    float d1 = textureLod(HZBSampler, sampleUV1, mip).r;
    float d2 = textureLod(HZBSampler, sampleUV2, mip).r;
    float d3 = textureLod(HZBSampler, sampleUV3, mip).r;
    float d4 = textureLod(HZBSampler, sampleUV4, mip).r;

    float hzbDepth = min(min(d1, d2), min(d3, d4));

    return nearestDepth >= hzbDepth;
}

void transformWorldAABB(in vec3 localMin, in vec3 localMax, in mat4 worldMatrix, out vec3 worldMin, out vec3 worldMax)
{
	vec3 center = (localMin + localMax) * 0.5;
	vec3 extent = (localMax - localMin) * 0.5;

	vec3 worldCenter = (worldMatrix * vec4(center, 1.0)).xyz;

	mat3 absWorld = mat3(
		abs(worldMatrix[0].xyz),
		abs(worldMatrix[1].xyz),
		abs(worldMatrix[2].xyz)
	);

	vec3 worldExtent = absWorld * extent;

	worldMin = worldCenter - worldExtent;
	worldMax = worldCenter + worldExtent;
}

bool isMeshletConeCulled(vec4 worldSphere, vec3 worldConeAxis, float coneCutoff, vec3 cameraPos)
{
    if (coneCutoff <= -1.0f)
        return false;

    return dot(normalize(worldSphere.xyz - cameraPos), worldConeAxis) >= coneCutoff + worldSphere.w / length(worldSphere.xyz - cameraPos);
}

const float TARGET_MAX_PIXEL_ERROR = 1.0;

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
void main()
{
    uint invocationIdx = gl_GlobalInvocationID.x;

     if (invocationIdx >= meshletCount)
        return;

    MeshletInfo meshletInfo = meshletsInfo[meshletInstancesDataBuffer.meshletInstancesData[invocationIdx].meshletIdx];
    uint instanceIdx = meshletInstancesDataBuffer.meshletInstancesData[invocationIdx].instanceIdx;
    CullingInstanceInfo cullingInstanceInfo = cullingInstancesInfo[instanceIdx];

    float sx = dot(cullingInstanceInfo.transform[0].xyz, cullingInstanceInfo.transform[0].xyz);
    float sy = dot(cullingInstanceInfo.transform[1].xyz, cullingInstanceInfo.transform[1].xyz);
    float sz = dot(cullingInstanceInfo.transform[2].xyz, cullingInstanceInfo.transform[2].xyz);
    float maxScale = sqrt(max(sx, max(sy, sz)));

    float projectionFactor = computeProjectionFactor();

    // Finding a group idx for the meshlet: it's either a child or a parent (or both)
    uint validGroupIdx = meshletInfo.groupIdxAsParent;
    if (validGroupIdx == -1)
    {
        validGroupIdx = meshletInfo.groupIdxAsChild;
    }
    MeshletGroupInfo meshletGroupInfo = meshletGroupsInfo[validGroupIdx];

    vec3 worldCenter = (cullingInstanceInfo.transform * vec4(meshletGroupInfo.boundingSphere.xyz, 1.0)).xyz;
    float worldRadius = meshletGroupInfo.boundingSphere.w * maxScale;
    float dist = max(length(worldCenter - getCameraPos()) - worldRadius, 0.0001);
    float currentError = (TARGET_MAX_PIXEL_ERROR * dist) / projectionFactor;

    vec3 parentWorldCenter = (cullingInstanceInfo.transform * vec4(meshletInfo.parentGroupBoundingSphere.xyz, 1.0)).xyz;
    float parentWorldRadius = meshletInfo.parentGroupBoundingSphere.w * maxScale;
    float parentDist = max(length(parentWorldCenter - getCameraPos()) - parentWorldRadius, 0.0001);
    float parentCurrentError = (TARGET_MAX_PIXEL_ERROR * parentDist) / projectionFactor;

    vec4 boundingSphereCenter = cullingInstanceInfo.transform * vec4(meshletInfo.boundingSphere.xyz, 1.0);
    float boundingSphereRadius = meshletInfo.boundingSphere.w;
    boundingSphereRadius *= maxScale;
    vec4 boundingSphere = vec4(vec3(boundingSphereCenter), boundingSphereRadius);

    vec4 coneData = unpackSnorm4x8(meshletInfo.coneAxisAndCutoff);
    vec3 worldConeAxis = normalize(mat3(cullingInstanceInfo.transform) * coneData.xyz);
    float coneCutoff = (coneData.w <= -0.99f) ? -1.0f : coneData.w;

    bool shouldRender = false;

    bool isVisible = isSphereVisible(boundingSphere, ubCamera.frustumPlanes) &&
        isSphereVisibleHZB(boundingSphere, getPreviousViewMatrix(), getProjectionMatrix()) &&
        !isMeshletConeCulled(boundingSphere, worldConeAxis, coneCutoff, getCameraPos());

    if (!isVisible)
        return;

    bool isQualityEnough = meshletInfo.lodError <= currentError;
    bool isParentQualityNotEnough = meshletInfo.parentLodError > parentCurrentError;

    if (pc.debugDrawMeshletHierarchyLevel != -1 && meshletInfo.groupIdxAsChild != -1)
    {
        MeshletGroupInfo meshletGroupAsChildInfo = meshletGroupsInfo[meshletInfo.groupIdxAsChild];
        if (meshletGroupAsChildInfo.hierarchyLevel == pc.debugDrawMeshletHierarchyLevel)
        {
            isQualityEnough = true;
            isParentQualityNotEnough = true;
        }
        else
        {
            isQualityEnough = true;
            isParentQualityNotEnough = false;
        }
    }
    if (pc.debugMeshletDrawGroupIdx != -1 && ((pc.debugUseParentGroup == 0 && meshletInfo.groupIdxAsChild != -1) ||(pc.debugUseParentGroup == 1 && meshletInfo.groupIdxAsParent != -1)))
    {
        if ((pc.debugUseParentGroup == 0 && meshletInfo.groupIdxAsChild == pc.debugMeshletDrawGroupIdx) || (pc.debugUseParentGroup == 1 && meshletInfo.groupIdxAsParent == pc.debugMeshletDrawGroupIdx))
        {
            isQualityEnough = true;
            isParentQualityNotEnough = true;
        }
        else
        {
            isQualityEnough = true;
            isParentQualityNotEnough = false;
        }
    }


    if (isQualityEnough && isParentQualityNotEnough)
    {
        if (meshletInfo.groupIdxAsChild == -1)
        {
            shouldRender = true;
        }
        else
        {
            MeshletGroupInfo meshletGroupAsChildInfo = meshletGroupsInfo[meshletInfo.groupIdxAsChild];

            bool hasNotLoadedSibling = false;
            uint notLoadedMeshletIdx = -1;
            for (uint i = 0; i < 4; ++i)
            {
                uint childMeshlet = meshletGroupAsChildInfo.childrenMeshletIndices[i];
                if (childMeshlet == -1)
                    break;

                MeshInfo meshInfo = meshesInfo[meshletInstancesDataBuffer.meshletInstancesData[invocationIdx].meshIdx];
                MeshletInfo childMeshletInfo = meshletsInfo[childMeshlet + meshInfo.meshletBaseIndex];

                if (childMeshletInfo.vertexOffset == -1)
                {
                    hasNotLoadedSibling = true;
                    notLoadedMeshletIdx = childMeshlet;
                    break;
                }
            }

            if (!hasNotLoadedSibling)
            {
                shouldRender = true;
            }
            else
            {
    #ifdef MESH_STREAMING
                uint feedbackCount = atomicAdd(outStreamingFeedbacksBuffer.outFeedbackCount, 1);
                if (feedbackCount < MAX_FEEDBACK_COUNT)
                {
                    outStreamingFeedbacksBuffer.outFeedbacks[feedbackCount].meshIdx = cullingInstanceInfo.meshIdx;

                    MeshInfo meshInfo = meshesInfo[meshletInstancesDataBuffer.meshletInstancesData[invocationIdx].meshIdx];
                    outStreamingFeedbacksBuffer.outFeedbacks[feedbackCount].meshletIdx = meshletInstancesDataBuffer.meshletInstancesData[invocationIdx].meshletIdx - meshInfo.meshletBaseIndex;
                }
    #endif
                return;
            }
        }
    }
    else if (!isParentQualityNotEnough) // parent is good too
    {
        return;
    }
    else if (!isQualityEnough && meshletInfo.vertexOffset != -1 && meshletInfo.groupIdxAsParent != -1)
    {
        // Check if children are loaded
        MeshletGroupInfo meshletGroupAsParentInfo = meshletGroupsInfo[meshletInfo.groupIdxAsParent];

        bool hasNotLoadedChild = false;
        for (uint i = 0; i < 4; ++i)
        {
            uint childMeshlet = meshletGroupAsParentInfo.childrenMeshletIndices[i];
            if (childMeshlet == -1)
                break;

            MeshInfo meshInfo = meshesInfo[meshletInstancesDataBuffer.meshletInstancesData[invocationIdx].meshIdx];
            MeshletInfo childMeshletInfo = meshletsInfo[childMeshlet + meshInfo.meshletBaseIndex];

            if (childMeshletInfo.vertexOffset == -1)
            {
                hasNotLoadedChild = true;
                break;
            }
        }

        if (hasNotLoadedChild)
        {
            if (meshletInfo.groupIdxAsChild != -1)
            {
                MeshletGroupInfo meshletGroupAsChildInfo = meshletGroupsInfo[meshletInfo.groupIdxAsChild];

                bool hasNotLoadedSibling = false;
                for (uint i = 0; i < 4; ++i)
                {
                    uint childMeshlet2 = meshletGroupAsChildInfo.childrenMeshletIndices[i];
                    if (childMeshlet2 == -1)
                        break;

                    MeshInfo meshInfo = meshesInfo[meshletInstancesDataBuffer.meshletInstancesData[invocationIdx].meshIdx];
                    MeshletInfo childMeshletInfo2 = meshletsInfo[childMeshlet2 + meshInfo.meshletBaseIndex];

                    if (childMeshletInfo2.vertexOffset == -1)
                    {
                        hasNotLoadedSibling = true;
                        break;
                    }
                }

                if (!hasNotLoadedSibling)
                    shouldRender = true;
            }
            else
            {
                shouldRender = true;
            }
        }
    }

    if (shouldRender && pc.debugDrawMeshletHierarchyLevel != -1)
    {
        MeshletGroupInfo meshletGroupAsChildInfo = meshletGroupsInfo[meshletInfo.groupIdxAsChild];
        if (meshletGroupAsChildInfo.hierarchyLevel != pc.debugDrawMeshletHierarchyLevel)
        {
            shouldRender = false;
        }
    }
    else if (shouldRender && pc.debugMeshletDrawGroupIdx != -1)
    {
        if ((pc.debugUseParentGroup == 0 && meshletInfo.groupIdxAsChild != pc.debugMeshletDrawGroupIdx) || (pc.debugUseParentGroup == 1 && meshletInfo.groupIdxAsParent != pc.debugMeshletDrawGroupIdx))
        {
            shouldRender = false;
        }
    }

    if (pc.onlyDrawMeshletIdx != -1 && meshletInstancesDataBuffer.meshletInstancesData[invocationIdx].meshletIdx != pc.onlyDrawMeshletIdx)
        shouldRender = false;

    if (shouldRender)
    {
        atomicAdd(outDebugData.primitiveCount, meshletInfo.indexCount);
        atomicAdd(outDebugData.meshletPassingCullingCount, 1);

        for (uint batchIdx = 0; batchIdx < MAX_BATCH_COUNT; batchIdx++)
        {
            if ((pc.cameraBatchMask & (1u << batchIdx)) != 0 && (cullingInstanceInfo.batchesMask & (1u << batchIdx)) != 0u)
            {
                uint targetCommandIdx = atomicAdd(outDrawCommandsBuffers[batchIdx].outDrawCommand.groupCountX, 1);

                outMeshletDataBuffers[batchIdx].outMeshletData[targetCommandIdx].instanceIdx = instanceIdx;
                outMeshletDataBuffers[batchIdx].outMeshletData[targetCommandIdx].vertexOffset = meshletInfo.vertexOffset;
                outMeshletDataBuffers[batchIdx].outMeshletData[targetCommandIdx].indexOffset = meshletInfo.indexOffset;
                outMeshletDataBuffers[batchIdx].outMeshletData[targetCommandIdx].indexCount = meshletInfo.indexCount;
                outMeshletDataBuffers[batchIdx].outMeshletData[targetCommandIdx].vertexCount = meshletInfo.vertexCount;
                outMeshletDataBuffers[batchIdx].outMeshletData[targetCommandIdx].meshletIdx = meshletInstancesDataBuffer.meshletInstancesData[invocationIdx].meshletIdx;
                outMeshletDataBuffers[batchIdx].outMeshletData[targetCommandIdx].groupMeshletIdx = (pc.debugUseParentGroup == 1 ? meshletInfo.groupIdxAsParent : meshletInfo.groupIdxAsChild);
            }
        }
    }
}
)"